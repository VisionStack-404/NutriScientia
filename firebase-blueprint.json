{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user's profile, photo, basic information, and dietary/health requirements.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Full display name",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Contact email address",
          "minLength": 3,
          "maxLength": 160
        },
        "age": {
          "type": "number",
          "description": "User age in years (1-120)"
        },
        "photoUrl": {
          "type": "string",
          "description": "Compressed avatar data URL or Google profile photo URL",
          "maxLength": 200000
        },
        "dietaryPreference": {
          "type": "string",
          "description": "Primary dietary preference",
          "enum": [
            "Vegetarian",
            "Vegan",
            "Pescatarian",
            "Omnivore",
            "Keto",
            "Gluten-Free"
          ]
        },
        "allergies": {
          "type": "array",
          "description": "Bounded list of up to 15 food allergies"
        },
        "healthGoals": {
          "type": "string",
          "description": "Primary nutritional or wellness objective",
          "minLength": 1,
          "maxLength": 80
        },
        "calorieTargetPerMeal": {
          "type": "number",
          "description": "Target calories per meal (100-3000 kcal)"
        },
        "preferences": {
          "type": "object",
          "description": "Saved light/dark theme and notification toggles"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": [
        "uid",
        "name",
        "email",
        "dietaryPreference",
        "allergies",
        "healthGoals",
        "calorieTargetPerMeal",
        "createdAt",
        "updatedAt"
      ]
    },
    "MealHistoryEntry": {
      "title": "MealHistoryEntry",
      "description": "Cloud-synced record of a scanned food meal analysis.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Entry identifier",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "foodName": {
          "type": "string",
          "description": "Identified dish name",
          "minLength": 1,
          "maxLength": 120
        },
        "cuisine": {
          "type": "string",
          "description": "Cuisine classification",
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "description": "Meal course category",
          "maxLength": 80
        },
        "calories": {
          "type": "number",
          "description": "Calories per serving"
        },
        "proteinGrams": {
          "type": "number",
          "description": "Protein grams per serving"
        },
        "carbsGrams": {
          "type": "number",
          "description": "Carbohydrates grams per serving"
        },
        "fatGrams": {
          "type": "number",
          "description": "Fat grams per serving"
        },
        "matchScore": {
          "type": "number",
          "description": "Profile match percentage (0-100)"
        },
        "overallRisk": {
          "type": "string",
          "description": "Safety risk summary",
          "maxLength": 40
        },
        "thumbnailUrl": {
          "type": "string",
          "description": "Compressed meal thumbnail URL or data URL",
          "maxLength": 200000
        },
        "analysisSnapshot": {
          "type": "object",
          "description": "Structured meal analysis snapshot for restoring full 5-tab detail views"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": [
        "id",
        "userId",
        "foodName",
        "calories",
        "proteinGrams",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profile, avatar, and dietary requirements owned exclusively by {userId}."
    },
    "/users/{userId}/history/{entryId}": {
      "schema": {
        "$ref": "#/entities/MealHistoryEntry"
      },
      "description": "Private chronological food scan history entries owned exclusively by {userId}."
    }
  }
}
