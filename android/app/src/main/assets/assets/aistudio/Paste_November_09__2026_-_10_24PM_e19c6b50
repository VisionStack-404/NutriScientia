// ==========================================
// FOOD LAB SCREEN
// ==========================================

class FoodLabScreen extends StatefulWidget {
  const FoodLabScreen({super.key});

  @override
  State<FoodLabScreen> createState() => _FoodLabScreenState();
}

class _FoodLabScreenState extends State<FoodLabScreen> {

  final foodOne = TextEditingController();
  final foodTwo = TextEditingController();

  String result = '';

  @override
  void dispose() {
    foodOne.dispose();
    foodTwo.dispose();
    super.dispose();
  }

  void runExperiment() {
    if (foodOne.text.trim().isEmpty ||
        foodTwo.text.trim().isEmpty) {

      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Please enter both food items.'),
        ),
      );

      return;
    }

    setState(() {
      result =
          'Experiment: ${foodOne.text} + ${foodTwo.text}\n\n'
          'Your experiment request is ready. '
          'Connect your Python backend to generate scientific '
          'nutrition, compatibility and safety analysis.';
    });
  }

  @override
  Widget build(BuildContext context) {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(18),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [

          const Text(
            'FOOD LAB™',
            style: TextStyle(
              fontSize: 25,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 6),

          const Text(
            'Virtual Food Experimentation Laboratory',
            style: TextStyle(
              color: Colors.white60,
              fontSize: 12,
            ),
          ),

          const SizedBox(height: 22),

          Container(
            width: double.infinity,
            padding: const EdgeInsets.all(20),
            decoration: BoxDecoration(
              color: const Color(0xFF131D2E),
              borderRadius: BorderRadius.circular(20),
              border: Border.all(
                color: const Color(0xFF3B82F6).withOpacity(0.4),
              ),
            ),
            child: const Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Icon(
                  Icons.biotech,
                  color: Color(0xFF3B82F6),
                  size: 40,
                ),
                SizedBox(height: 15),
                Text(
                  'Explore Food Combinations',
                  style: TextStyle(
                    fontSize: 19,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                SizedBox(height: 8),
                Text(
                  'Combine different foods and submit an experiment for scientific analysis.',
                  style: TextStyle(
                    color: Colors.white60,
                    fontSize: 13,
                    height: 1.5,
                  ),
                ),
              ],
            ),
          ),

          const SizedBox(height: 25),

          const Text(
            'Food Item 01',
            style: TextStyle(fontWeight: FontWeight.bold),
          ),

          const SizedBox(height: 10),

          TextField(
            controller: foodOne,
            decoration: InputDecoration(
              hintText: 'Example: Vanilla Ice Cream',
              filled: true,
              fillColor: const Color(0xFF131D2E),
              border: OutlineInputBorder(
                borderRadius: BorderRadius.circular(14),
                borderSide: BorderSide.none,
              ),
            ),
          ),

          const SizedBox(height: 20),

          const Center(
            child: Icon(
              Icons.add_circle,
              color: Color(0xFF3B82F6),
              size: 35,
            ),
          ),

          const SizedBox(height: 20),

          const Text(
            'Food Item 02',
            style: TextStyle(fontWeight: FontWeight.bold),
          ),

          const SizedBox(height: 10),

          TextField(
            controller: foodTwo,
            decoration: InputDecoration(
              hintText: 'Example: Gulab Jamun',
              filled: true,
              fillColor: const Color(0xFF131D2E),
              border: OutlineInputBorder(
                borderRadius: BorderRadius.circular(14),
                borderSide: BorderSide.none,
              ),
            ),
          ),

          const SizedBox(height: 25),

          SizedBox(
            width: double.infinity,
            child: ElevatedButton.icon(
              onPressed: runExperiment,
              style: ElevatedButton.styleFrom(
                backgroundColor: const Color(0xFF3B82F6),
                foregroundColor: Colors.white,
                padding: const EdgeInsets.all(16),
                shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(14),
                ),
              ),
              icon: const Icon(Icons.play_arrow),
              label: const Text('Run Experiment'),
            ),
          ),

          if (result.isNotEmpty) ...[
            const SizedBox(height: 25),

            Container(
              width: double.infinity,
              padding: const EdgeInsets.all(18),
              decoration: BoxDecoration(
                color: const Color(0xFF131D2E),
                borderRadius: BorderRadius.circular(16),
                border: Border.all(
                  color: const Color(0xFF10B981),
                ),
              ),
              child: Text(
                result,
                style: const TextStyle(
                  fontSize: 13,
                  height: 1.6,
                ),
              ),
            ),
          ],

          const SizedBox(height: 20),

          const InfoCard(
            icon: Icons.warning_amber,
            title: 'Food Safety',
            description:
                'This preview does not establish whether a food combination is safe to consume.',
          ),
        ],
      ),
    );
  }
}

